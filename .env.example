# Copy values into a protected environment source or secret manager. Never
# commit a populated file. Values below are placeholders, not credentials.
CCF_ENV=development
DATABASE_URL=mysql+pymysql://ccf_app:replace-password@127.0.0.1:3306/ccf_events
CCF_DASHBOARD_SECRET=replace-with-at-least-32-random-characters

# Runtime and application limits.
CCF_STAGING_DIR=instance/staged_imports
CCF_MAX_UPLOAD_MB=32
CCF_SESSION_HOURS=8
CCF_CSRF_TIME_LIMIT_SECONDS=7200
CCF_ADMIN_TABLES_ENABLED=1
CCF_STANDARD_USER_MUTATIONS_ALLOWED=1

# Production/staging logging normally uses JSON. Do not enable debug in production.
CCF_DASHBOARD_DEBUG=0
CCF_LOG_LEVEL=INFO
CCF_LOG_FORMAT=text

# Production HTTPS/session configuration.
CCF_SESSION_COOKIE_SECURE=0
CCF_SESSION_COOKIE_SAMESITE=Lax
CCF_ANALYTICS_MIN_GROUP_SIZE=5
CCF_TRUSTED_HOSTS=localhost,127.0.0.1

# Forwarded headers are trusted only from the explicitly configured number of
# reverse-proxy hops. Keep all values at zero without a trusted proxy.
CCF_PROXY_X_FOR=0
CCF_PROXY_X_PROTO=0
CCF_PROXY_X_HOST=0
CCF_PROXY_X_PORT=0
CCF_PROXY_X_PREFIX=0

# Schema checks are mandatory in production and staging by default.
CCF_REQUIRE_SCHEMA_CURRENT=0
CCF_DB_POOL_RECYCLE_SECONDS=1800
CCF_DB_POOL_SIZE=5
CCF_DB_MAX_OVERFLOW=10

# Container/WSGI tuning.
PORT=8080
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
